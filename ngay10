import numpy as np

ngay = [1, 2, 3, 4, 5, 6, 7]
nhiet_do = [32,33,35,36,34,33,38]
so_nguoi = [1, 1, 2, 2, 1, 3, 1]
pin = [100,85,70,55,40,25,10]
X = np.array([
    [1, 32, 1],
    [2, 33, 1],
    [3, 35, 2],
    [4, 36, 2],
    [5, 34, 1],
    [6, 33, 3],
    [7, 38, 1]
])

y = np.array(pin)

X_with_b = np.c_[np.ones(len(X)), X]

he_so = np.linalg.lstsq(X_with_b, y, rcond=None)[0]
print("AI tự học được 4 hệ số:", he_so)

def du_doan_pinv10(ngay_moi, nhiet_moi, nguoi_moi):
    return he_so[0] + he_so[1]*ngay_moi + he_so[2]*nhiet_moi + he_so[3]*nguoi_moi

print("Ngày 8, 32 độ, 1 người i:", du_doan_pinv10(8, 32, 1))
print("Ngày 8, 32 độ, 3 người:", du_doan_pinv10(8, 32, 3))
