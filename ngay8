a = -14.46
b = 119.29

def du_doan_pinv2(ngay_du_doan, co_dieu_hoa, nhiet_do_ngay_do):
    pin_goc = a * ngay_du_doan + b

    if co_dieu_hoa == True:
        if nhiet_do_ngay_do > 35:
            pin_goc = pin_goc - 8 
        else:
            pin_goc = pin_goc - 3
    return pin_goc

